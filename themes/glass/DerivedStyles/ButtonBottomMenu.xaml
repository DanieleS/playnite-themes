<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Input hint as a small glass pill. -->
    <Style x:Key="ButtonBottomMenu" TargetType="ButtonEx">
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#29FFFFFF" BorderThickness="1"
                            CornerRadius="26" Padding="10,8,22,8">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{TemplateBinding InputHint}"
                                            Height="28" VerticalAlignment="Center"
                                            Margin="0,0,10,0" Focusable="False" />
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontWeight="SemiBold" FontSize="19"
                                       VerticalAlignment="Center">
                                <ContentPresenter />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPrimaryHint" TargetType="ButtonEx" BasedOn="{StaticResource ButtonBottomMenu}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="#FFFFFFFF" CornerRadius="26" Padding="10,8,26,8">
                        <StackPanel Orientation="Horizontal">
                            <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse Width="34" Height="34" Fill="#FF000000" />
                                <ContentControl ContentTemplate="{TemplateBinding InputHint}"
                                                Height="28" VerticalAlignment="Center" HorizontalAlignment="Center" Focusable="False" />
                            </Grid>
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontWeight="Bold" FontSize="19"
                                       Foreground="#FF000000" VerticalAlignment="Center">
                                <ContentPresenter />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
