<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!--
        Shelf / Game details: the back of the box.
        Big cover on the left, then kicker, title (or ink-tinted logo), description, dotted-leader specs
        and a rubber stamp with the completion status.
    -->
    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">
                    <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="560" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>

                        <Rectangle Grid.ColumnSpan="5" Grid.RowSpan="3" Fill="{DynamicResource ShelfLightBrush}" />

                        <!-- Cover, tilted slightly like a box on a table -->
                        <Grid Grid.Column="1" Grid.Row="1" Width="540" Height="810" VerticalAlignment="Top"
                              HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <SkewTransform AngleY="-2" />
                            </Grid.RenderTransform>
                            <Border Background="#FF1D1B17" CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="26" Direction="300" BlurRadius="50" Opacity="0.45" Color="#FF3C2805" />
                                </Border.Effect>
                            </Border>
                            <Image x:Name="PART_ImageCover" Stretch="UniformToFill" Margin="5"
                                   RenderOptions.BitmapScalingMode="Fant" />
                            <Rectangle Margin="5">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
                                        <GradientStop Color="#33FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.35" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <!-- Back of the box -->
                        <DockPanel Grid.Column="3" Grid.Row="1">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource ShelfKicker}"
                                           Text="{Binding Genres, Converter={StaticResource ListToStringConverter}}" />
                                <TextBlock Style="{DynamicResource ShelfKicker}" Text="  ·  " />
                                <TextBlock Style="{DynamicResource ShelfKicker}" Text="{Binding ReleaseYear}" />
                                <TextBlock Style="{DynamicResource ShelfKicker}" Text="  ·  " />
                                <TextBlock Style="{DynamicResource ShelfKicker}"
                                           Text="{Binding Developers, Converter={StaticResource ListToStringConverter}}" />
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource ShelfDisplay}" FontSize="74"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="190"
                                       Text="{Binding DisplayName}" />

                            <Grid DockPanel.Dock="Top" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>

                                <!-- Specs with dotted leaders -->
                                <Grid Grid.Column="0" Margin="0,0,40,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Style="{DynamicResource ShelfSpecLabel}" Text="{DynamicResource LOCTimePlayed}" VerticalAlignment="Bottom" />
                                    <Line Grid.Row="0" Grid.Column="1" Style="{DynamicResource ShelfLeader}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{DynamicResource ShelfSpecValue}" VerticalAlignment="Bottom"
                                               Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}" />

                                    <TextBlock Grid.Row="1" Style="{DynamicResource ShelfSpecLabel}" Text="{DynamicResource LOCLastPlayed}" VerticalAlignment="Bottom" />
                                    <Line Grid.Row="1" Grid.Column="1" Style="{DynamicResource ShelfLeader}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{DynamicResource ShelfSpecValue}" VerticalAlignment="Bottom"
                                               Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" />

                                    <TextBlock Grid.Row="2" Style="{DynamicResource ShelfSpecLabel}" Text="{DynamicResource LOCPlayCountLabel}" VerticalAlignment="Bottom" />
                                    <Line Grid.Row="2" Grid.Column="1" Style="{DynamicResource ShelfLeader}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{DynamicResource ShelfSpecValue}" VerticalAlignment="Bottom"
                                               Text="{Binding PlayCount}" />

                                    <TextBlock Grid.Row="3" Style="{DynamicResource ShelfSpecLabel}" Text="{DynamicResource LOCGamePlatformTitle}" VerticalAlignment="Bottom" />
                                    <Line Grid.Row="3" Grid.Column="1" Style="{DynamicResource ShelfLeader}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{DynamicResource ShelfSpecValue}" VerticalAlignment="Bottom"
                                               Text="{Binding Platforms, Converter={StaticResource ListToStringConverter}}" />

                                    <TextBlock Grid.Row="4" Style="{DynamicResource ShelfSpecLabel}" Text="{DynamicResource LOCSourceLabel}" VerticalAlignment="Bottom" />
                                    <Line Grid.Row="4" Grid.Column="1" Style="{DynamicResource ShelfLeader}" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{DynamicResource ShelfSpecValue}" VerticalAlignment="Bottom"
                                               Text="{Binding Source.Name}" />
                                </Grid>

                                <!-- Rubber stamp -->
                                <Grid Grid.Column="1" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5" Opacity="0.9">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="-12" />
                                    </Grid.RenderTransform>
                                    <Ellipse Stroke="{DynamicResource ShelfAccentBrush}" StrokeThickness="6" />
                                    <Ellipse Stroke="{DynamicResource ShelfAccentBrush}" StrokeThickness="2" Margin="12" />
                                    <StackPanel VerticalAlignment="Center" Margin="26,0,26,0">
                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource ShelfAccentBrush}" TextAlignment="Center"
                                                   Text="{Binding Source={StaticResource LOCCompletionStatus}, Converter={StaticResource StringToUpperCaseConverter}}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Style="{DynamicResource ShelfDisplay}" FontSize="30"
                                                   Foreground="{DynamicResource ShelfAccentBrush}" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="80" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CompletionStatus.Name}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Actions -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,30,0,0">
                                <ButtonEx x:Name="PART_ButtonContext" Style="{DynamicResource ShelfActionButton}" />
                                <ButtonEx x:Name="PART_ButtonOptions" Style="{DynamicResource ShelfActionButton}"
                                          Content="{DynamicResource LOCGameOptions}" />
                            </StackPanel>

                            <!-- Description -->
                            <ScrollViewerEx x:Name="PART_ScrollHtmlDescription" Margin="0,30,0,0"
                                            DockPanel.Dock="Top" CustomScrollAmount="42">
                                <HtmlTextView x:Name="PART_HtmlDescription"
                                              HtmlFontSize="19"
                                              HtmlFontFamily="{DynamicResource ShelfFontBody}"
                                              HtmlForeground="#FF3A352D"
                                              LinkForeground="#FFB4442C"
                                              FocusVisualStyle="{x:Null}" />
                            </ScrollViewerEx>
                        </DockPanel>

                        <!-- Back hint -->
                        <StackPanel Grid.Column="3" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Height="30" Focusable="False" />
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" Margin="10,0,0,0" FontWeight="Bold"
                                       Foreground="{DynamicResource ShelfInkBrush}" VerticalAlignment="Center"
                                       Text="{DynamicResource LOCDS_Shelf_BackToShelf}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
