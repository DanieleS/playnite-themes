<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rounded-corner mask: a fixed-size rounded rectangle stretched over the tile. -->
    <VisualBrush x:Key="RoundedTileMask" Stretch="Fill">
        <VisualBrush.Visual>
            <Border Width="200" Height="300" CornerRadius="12" Background="#FF000000" />
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- Cover tile. PART_ImageCover keeps Playnite's async loading and default-cover fallback. -->
    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid>
                        <Border CornerRadius="10" Background="#FF1A1A1A">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="6" BlurRadius="24" Opacity="0.5" Color="#FF000000" />
                            </Border.Effect>
                        </Border>
                        <Image x:Name="PART_ImageCover" RenderOptions.BitmapScalingMode="Fant"
                               Stretch="{Settings CoverArtStretch}" StretchDirection="Both"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               OpacityMask="{DynamicResource RoundedTileMask}" />
                        <Border x:Name="Darken" CornerRadius="10" Background="#99000000" Visibility="Collapsed" />
                        <Border CornerRadius="0,0,10,10" VerticalAlignment="Bottom" Padding="10,24,10,10"
                                Visibility="{Settings Fullscreen.ShowGameTitles}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#DD000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource TextBlockBaseStyle}" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeSmall}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Darken" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
