<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Input hint: controller glyph + label inside a translucent pill. Not focusable, driven by the gamepad. -->
    <Style x:Key="ButtonBottomMenu" TargetType="ButtonEx">
        <Setter Property="Background" Value="{DynamicResource CinemaPillBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}" CornerRadius="28" Padding="12,10,26,10">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{TemplateBinding InputHint}"
                                            Height="30" VerticalAlignment="Center"
                                            Margin="0,0,10,0" Focusable="False" />
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontWeight="SemiBold" FontSize="21"
                                       Foreground="{DynamicResource CinemaTextBrush}"
                                       VerticalAlignment="Center">
                                <ContentPresenter />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The primary action (Play / Install) is a solid white pill. -->
    <Style x:Key="CinemaPrimaryHint" TargetType="ButtonEx" BasedOn="{StaticResource ButtonBottomMenu}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="#FFFFFFFF" CornerRadius="28" Padding="12,10,30,10">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{TemplateBinding InputHint}"
                                            Height="30" VerticalAlignment="Center"
                                            Margin="0,0,10,0" Focusable="False" />
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontWeight="Bold" FontSize="21" Foreground="#FF000000"
                                       VerticalAlignment="Center">
                                <ContentPresenter />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
