<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Journal: a dashboard of how you actually play. Graphite, one coral accent, serif headlines. -->

    <Color x:Key="GlyphColor">#FFFF7A45</Color>
    <Color x:Key="GlyphLightColor">#FFFFA070</Color>
    <Color x:Key="SelectionLightColor">#FF8B93A1</Color>
    <Color x:Key="OverlayColor">#CC0F1115</Color>
    <Color x:Key="ControlBackgroundColor">#FF262A33</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF171A20</Color>
    <Color x:Key="TextColor">#FFEEF0F3</Color>
    <Color x:Key="TextColorDark">#FF8B93A1</Color>

    <SolidColorBrush x:Key="MainBackgourndBrush" Color="#FF0F1115" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="BottomBarBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFEEF0F3" />
    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#FF171A20" />
    <SolidColorBrush x:Key="GameDetailsBackgroundBrush" Color="#FF0F1115" />

    <SolidColorBrush x:Key="JournalInkBrush" Color="#FFEEF0F3" />
    <SolidColorBrush x:Key="JournalSoftBrush" Color="#FF8B93A1" />
    <SolidColorBrush x:Key="JournalAccentBrush" Color="#FFFF7A45" />
    <SolidColorBrush x:Key="JournalCardBrush" Color="#FF171A20" />
    <SolidColorBrush x:Key="JournalLineBrush" Color="#FF262A33" />

    <FontFamily x:Key="JournalFontBody">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="JournalFontDisplay">Georgia</FontFamily>
    <FontFamily x:Key="JournalFontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontTitilliumWeb">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontTitilliumWebLight">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontTitilliumWebBold">Segoe UI Variable Display Semibold, Segoe UI Semibold</FontFamily>

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource JournalFontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Small uppercase mono label used on every tile. -->
    <Style x:Key="JournalLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource JournalFontMono}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource JournalSoftBrush}" />
    </Style>

    <Style x:Key="JournalBigNumber" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="JournalTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource JournalCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JournalLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="26,22,26,22" />
        <Setter Property="Margin" Value="9" />
    </Style>

    <Style x:Key="JournalButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource JournalInkBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource JournalFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border x:Name="Body" Background="#26FFFFFF" CornerRadius="12" Padding="28,12,28,12">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource JournalAccentBrush}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="#FF0F1115" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
