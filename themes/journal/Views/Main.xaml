<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    mc:Ignorable="d">

    <!--
        Journal / Main
        A still grid of covers (Playnite's own virtualized grid, so navigation is spatial and any library size
        works) and a bar for the selected game with its hours in large type.
        Suggested: Settings > Layout, Rows 2, Horizontal layout on.
    -->
    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="160" />
                                <RowDefinition Height="76" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="70,0,70,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{DynamicResource JournalFontDisplay}" FontStyle="Italic" FontSize="56"
                                               Foreground="{DynamicResource JournalAccentBrush}" Text="{DynamicResource LOCLibrary}" />
                                    <TextBlock Style="{DynamicResource JournalLabel}" Margin="2,6,0,0"
                                               Text="{Binding Items.Count, ElementName=JournalList}" />
                                </StackPanel>

                                <FilterPresetSelector x:Name="PART_FilterPresetSelector" Grid.Column="1"
                                                      HorizontalAlignment="Right" Margin="40,0,40,0" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl x:Name="PART_ElemBatteryStatus" Focusable="False" FontSize="30"
                                                    VerticalAlignment="Center" Margin="10,0,6,0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource JournalAccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                    <TextBlock x:Name="PART_TextBatteryPercentage" Margin="0,0,16,0"
                                               Style="{DynamicResource TextBlockBaseStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PART_TextClock" Margin="10,0,16,0" FontFamily="{DynamicResource JournalFontMono}"
                                               Style="{DynamicResource TextBlockBaseStyle}" VerticalAlignment="Center" />
                                    <ButtonEx x:Name="PART_ButtonProgramUpdate" Margin="4,0,4,0" Height="48" MinWidth="48"
                                              Style="{DynamicResource ButtonTopMenu}">
                                        <TextBlock Text="&#xef08;" FontFamily="{StaticResource FontIcoFont}" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </ButtonEx>
                                    <ButtonEx x:Name="PART_ButtonNotifications" Margin="4,0,4,0" Height="48" MinWidth="48">
                                        <Grid>
                                            <TextBlock Text="&#xeea3;" FontFamily="{StaticResource FontIcoFont}" FontSize="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <Ellipse Width="12" Height="12" Fill="{DynamicResource JournalAccentBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                                        </Grid>
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource ButtonTopMenu}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                    </ButtonEx>
                                    <ButtonEx x:Name="PART_ButtonMainMenu" Style="{DynamicResource ButtonTopMenu}"
                                              Margin="4,0,0,0" Height="48" MinWidth="48">
                                        <Image RenderOptions.BitmapScalingMode="Fant" Margin="2"
                                               Source="{ThemeFile 'Images/applogo_clean.png'}" />
                                    </ButtonEx>
                                </StackPanel>
                            </Grid>

                            <!-- The mosaic -->
                            <DockPanel Grid.Row="1">
                                <Filters x:Name="PART_ElemFilters" DockPanel.Dock="Left" Focusable="False" />
                                <FiltersAdditional x:Name="PART_ElemFiltersAdditional" DockPanel.Dock="Left" Focusable="False" />
                                <ContentControl x:Name="PART_ContentFilterItems" DockPanel.Dock="Left" Focusable="False" />
                                <ListBoxEx x:Name="JournalList" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                           Margin="56,0,56,0"
                                           Background="Transparent" BorderThickness="0"
                                           DockPanel.Dock="Right"
                                           ItemsSource="{Binding GamesView.CollectionView}"
                                           SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                           Visibility="{Binding GameListVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           FocusBahaviors.FocusBinding="{Binding GameListFocused}"
                                           ItemContainerStyle="{DynamicResource ListGameItemStyle}"
                                           KeyboardNavigation.DirectionalNavigation="Once">
                                    <!-- Our own list with Playnite's virtualized tile panel: the theme decides rows and size,
                                         instead of Settings > Layout. -->
                                    <ListBoxEx.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <FullscreenTilePanel Rows="2" Columns="8" UseHorizontalLayout="True"
                                                                 ItemAspectRatio="2:3" ItemSpacing="22"
                                                                 SmoothScrollEnabled="{Settings Fullscreen.SmoothScrolling}" />
                                        </ItemsPanelTemplate>
                                    </ListBoxEx.ItemsPanel>
                                    <ListBoxEx.ItemTemplate>
                                        <DataTemplate>
                                            <GameListItem Style="{DynamicResource ListGameItemTemplate}" />
                                        </DataTemplate>
                                    </ListBoxEx.ItemTemplate>
                                    <ListBoxEx.InputBindings>
                                        <KeyBinding Key="A" Command="{Binding ToggleGameDetailsCommand}" />
                                        <KeyBinding Key="X" Command="{Binding OpenGameMenuCommand}" />
                                        <KeyBinding Key="Enter" Command="{Binding ActivateSelectedCommand}" />
                                        <pin:GameControllerInputBinding Button="A" Command="{Binding ToggleGameDetailsCommand}" />
                                        <pin:GameControllerInputBinding Button="X" Command="{Binding ActivateSelectedCommand}" />
                                        <pin:GameControllerInputBinding Button="Start" Command="{Binding OpenGameMenuCommand}" />
                                    </ListBoxEx.InputBindings>
                                </ListBoxEx>
                            </DockPanel>

                            <TextBlock Grid.Row="1" FontSize="30" Text="{DynamicResource LOCNoGamesFound}"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=JournalList}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Selected game bar -->
                            <Border Grid.Row="2" Margin="70,14,70,14" Style="{DynamicResource JournalTile}" Padding="34,0,34,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="34" FontWeight="Bold"
                                                       MaxWidth="900" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding SelectedGame.DisplayName}" />
                                            <TextBlock Style="{DynamicResource JournalLabel}" Margin="22,0,0,5" VerticalAlignment="Bottom"
                                                       Text="{Binding SelectedGame.ReleaseYear}" />
                                            <TextBlock Style="{DynamicResource JournalLabel}" Margin="0,0,0,5" VerticalAlignment="Bottom" Text="  ·  " />
                                            <TextBlock Style="{DynamicResource JournalLabel}" Margin="0,0,0,5" VerticalAlignment="Bottom"
                                                       MaxWidth="360" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding SelectedGame.Genres, Converter={StaticResource ListToStringConverter}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <ButtonEx x:Name="PART_ButtonInstall" InputHint="{DynamicResource ButtonPromptX}" Style="{DynamicResource ButtonBottomMenu}"
                                                      Content="{DynamicResource LOCInstallGame}" />
                                            <ButtonEx x:Name="PART_ButtonPlay" InputHint="{DynamicResource ButtonPromptX}" Style="{DynamicResource ButtonBottomMenu}"
                                                      Content="{DynamicResource LOCPlayGame}" />
                                            <ButtonEx x:Name="PART_ButtonDetails" InputHint="{DynamicResource ButtonPromptA}" Style="{DynamicResource ButtonBottomMenu}"
                                                      Content="{DynamicResource LOCGameDetails}" />
                                            <ButtonEx x:Name="PART_ButtonGameOptions" Style="{DynamicResource ButtonBottomMenu}"
                                                      Content="{DynamicResource LOCGameOptions}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0">
                                        <TextBlock Style="{DynamicResource JournalBigNumber}" Foreground="{DynamicResource JournalAccentBrush}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding SelectedGame.Playtime, Converter={StaticResource PlayTimeToStringConverter}}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Style="{DynamicResource JournalLabel}" Text="{DynamicResource LOCLastPlayed}" />
                                            <TextBlock Style="{DynamicResource JournalLabel}" Text="  " />
                                            <TextBlock Style="{DynamicResource JournalLabel}" Foreground="{DynamicResource JournalInkBrush}"
                                                       Text="{Binding SelectedGame.LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Footer -->
                            <Grid Grid.Row="3" Margin="70,0,70,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ButtonEx x:Name="PART_ButtonSearch" Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCSearchLabel}" />
                                    <ButtonEx x:Name="PART_ButtonFilter" Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCFilter}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" x:Name="PART_ElemSearchActive" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" TextAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}"
                                               Foreground="{DynamicResource JournalSoftBrush}"
                                               Text="{DynamicResource LOCGameListSearchResults}" />
                                    <TextBlock TextAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}"
                                               Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="PART_ElemExtraFilterActive" FontSize="18"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Foreground="{DynamicResource JournalSoftBrush}"
                                           Text="{DynamicResource LOCGameListExtraFiltered}" />
                                <StackPanel x:Name="PART_ElemProgressIndicator" Grid.Column="2"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="PART_TextProgressTooltip" Margin="0,0,15,0" FontSize="18"
                                               VerticalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" />
                                    <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                    Height="34" Width="34" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <GameStatus x:Name="PART_ElemGameStatus"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
