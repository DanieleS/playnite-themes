<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    mc:Ignorable="d">

    <!--
        Journal / Main
        The library is a still mosaic of big, wide, tall and small tiles, repeating a fixed 25-game pattern.
        It's one virtualized horizontal row where tiles stack into columns (see scripts/gen_mosaic.py), so it
        scales to any library. Focus moves spatially: WPF picks the tile actually above/below/beside.
    -->

    <!-- Tile content. A GameListItem, so plugin elements (Extra Metadata Loader logo) get the game context. -->
    <Style x:Key="JournalMosaicTile" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid>
                        <!-- Cover: always underneath, so wide tiles without a background still show something -->
                        <Border CornerRadius="14" Background="{DynamicResource JournalCardBrush}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="6" BlurRadius="20" Opacity="0.45" Color="#FF000000" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding FullscreenListItemCoverObject}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <!-- Background art, for big and wide tiles -->
                        <Border x:Name="Art" CornerRadius="14" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding DisplayBackgroundImageObject}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.5" />
                                    <GradientStop Color="#D90F1115" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" Focusable="False" Visibility="Collapsed"
                                        MaxWidth="320" MaxHeight="120" Margin="26,0,26,52"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="Caption" Text="{Binding DisplayName}" Margin="16,0,16,12"
                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                   Style="{DynamicResource TextBlockBaseStyle}" FontSize="19" FontWeight="SemiBold" />
                        <Border x:Name="Darken" CornerRadius="14" Background="#8C000000" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="Big">
                            <Setter TargetName="Art" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ExtraMetadataLoader_LogoLoaderControl" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Caption" Property="FontSize" Value="22" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="Wide">
                            <Setter TargetName="Art" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="Small">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Darken" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Container: size and position come from the generated per-index triggers below. -->
    <Style x:Key="JournalMosaicItemBase" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <GameListItem Style="{StaticResource JournalMosaicTile}" />
                        <Border x:Name="Ring" BorderBrush="{DynamicResource JournalInkBrush}" BorderThickness="4"
                                CornerRadius="19" Margin="-7" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter Property="Panel.ZIndex" Value="90" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BEGIN GENERATED MOSAIC (scripts/gen_mosaic.py) -->
    <sys:Int32 x:Key="JournalMosaicPeriod">25</sys:Int32>
    <sys:Double x:Key="JournalMosaicHeight">624</sys:Double>
